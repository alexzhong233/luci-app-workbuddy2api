#!/bin/sh /etc/rc.common
# 本地·Rust 版 WorkBuddy2API：procd 托管 /usr/bin/wb-backend。
#
# 这个二进制是静态链接的 musl 单文件，不依赖 python 或任何共享库；参数与
# 数据目录全部来自 /etc/config/workbuddy2api（和本地·原版共用同一份 uci、
# 同一个 accounts_dir / usage_dir），所以两种本地实现可以互换而不丢账号。
#
# --lan：监听 0.0.0.0 时必须带 API Key，否则谁都能拿你的账号额度。

START=96
STOP=10
USE_PROCD=1

start_service() {
	local host port accounts_dir usage_dir

	config_load workbuddy2api
	config_get host main host '0.0.0.0'
	config_get port main port '8788'
	config_get accounts_dir main accounts_dir '/etc/workbuddy2api/accounts'
	config_get usage_dir main usage_dir '/etc/workbuddy2api/usage'

	mkdir -p "$accounts_dir" "$usage_dir"
	chmod 700 "$accounts_dir" 2>/dev/null

	procd_open_instance
	procd_set_param command /usr/bin/wb-backend \
		--lan --host "$host" --port "$port" \
		--accounts-dir "$accounts_dir" --usage-dir "$usage_dir"
	# 自更新换的是磁盘上的这个文件，procd 的 command 是绝对路径、不会跟着变，
	# 所以关掉自带更新，统一由 LuCI 页面走「卸载重装 / 更新」这条线。
	procd_set_param env WB_UPDATE_INSTALL_ENABLED=0
	# 意外退出自动拉起；一小时崩 5 次以内一直重试（retry=0 表示不限次）
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t workbuddy2api-rust "服务停止"
}

reload_service() {
	logger -t workbuddy2api-rust "配置已重载（restart 后生效）"
}
